{
  "name": "@gitatlas/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "GitAtlas 桌面端（Electron 外壳）",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "node ../../scripts/build-desktop.mjs --dir",
    "pack": "node ../../scripts/build-desktop.mjs",
    "pack:portable": "node ../../scripts/build-desktop.mjs --portable",
    "pack:dir": "node ../../scripts/build-desktop.mjs --dir"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.gitatlas.desktop",
    "productName": "GitAtlas",
    "copyright": "GitAtlas",
    "directories": {
      "output": "../../release",
      "buildResources": "build"
    },
    "electronDist": "node_modules/electron/dist",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "npmRebuild": false,
    "files": [
      "main.cjs",
      "preload.cjs",
      "build/server.cjs",
      "build/web/**/*",
      "package.json",
      "!build/icon.png"
    ],
    "win": {
      "icon": "icon.png",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "GitAtlas-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "GitAtlas-Portable-${version}.exe",
      "requestExecutionLevel": "user"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GitAtlas",
      "deleteAppDataOnUninstall": false,
      "differentialPackage": false,
      "artifactName": "GitAtlas-Setup-${version}.exe"
    }
  }
}

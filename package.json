{
  "name": "gitatlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "node scripts/dev-desktop.mjs",
    "dev:server": "node --watch packages/server/src/main.ts",
    "dev:web": "pnpm --filter @gitatlas/web run dev",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "start:desktop": "pnpm --filter @gitatlas/desktop run start",
    "build:desktop": "node scripts/build-desktop.mjs",
    "build:desktop:dir": "node scripts/build-desktop.mjs --dir",
    "atlas": "node packages/core/src/cli.ts",
    "typecheck": "tsc -p packages/core/tsconfig.json && tsc -p packages/server/tsconfig.json && tsc -p apps/web/tsconfig.json",
    "test": "node --test packages/core/src/**/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.0"
  }
}
